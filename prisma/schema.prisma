generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TUTOR
  VET
}

enum Species {
  DOG
  CAT
  BIRD
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum AppointmentSyncStatus {
  PENDING_CREATE
  SYNCED
  PENDING_UPDATE
  PENDING_DELETE
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum NotificationKind {
  DOSE_REMINDER
  APPOINTMENT_REMINDER
  CLINICAL_NOTE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Tutor {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
  phone           String?
  profileImageUrl String?  @map("profile_image_url")
  role            Role     @default(TUTOR)
  timezone        String   @default("America/Fortaleza")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  pets             Pet[]
  appointments     Appointment[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  googleOAuthToken GoogleOAuthToken?

  @@map("tutor")
}

model GoogleOAuthToken {
  id           String   @id @default(uuid())
  tutorId      String   @unique @map("tutor_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  scopes       String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("google_oauth_token")
}

model DeviceToken {
  id         String         @id @default(uuid())
  tutorId    String         @map("tutor_id")
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @updatedAt @map("last_seen_at")

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("device_token")
}

model Pet {
  id        String    @id @default(uuid())
  name      String
  species   Species
  breed     String?
  sex       Sex
  birthDate DateTime? @map("birth_date")
  weight    Float?
  photoUrl  String?   @map("photo_url")
  tutorId   String    @map("tutor_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tutor             Tutor              @relation(fields: [tutorId], references: [id])
  vaccineRecords    VaccineRecord[]
  dewormingRecords  DewormingRecord[]
  medicationRecords MedicationRecord[]
  carteiraDigital   CarteiraDigital?
  appointments      Appointment[]
  notasClinicas     NotaClinica[]

  @@map("pet")
}

model CarteiraDigital {
  id        String   @id @default(uuid())
  petId     String   @unique @map("pet_id")
  token     String   @unique
  qrCodeUrl String?  @map("qr_code_url")
  createdAt DateTime @default(now()) @map("created_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("carteira_digital")
}

model VaccineRecord {
  id               String    @id @default(uuid())
  petId            String    @map("pet_id")
  vaccineName      String    @map("vaccine_name")
  appliedAt        DateTime  @map("applied_at")
  nextDoseAt       DateTime? @map("next_dose_at")
  lastNotifiedAt   DateTime? @map("last_notified_at")
  veterinarianName String?   @map("veterinarian_name")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("vaccine_record")
}

model DewormingRecord {
  id               String    @id @default(uuid())
  petId            String    @map("pet_id")
  productName      String    @map("product_name")
  appliedAt        DateTime  @map("applied_at")
  nextDoseAt       DateTime? @map("next_dose_at")
  lastNotifiedAt   DateTime? @map("last_notified_at")
  veterinarianName String?   @map("veterinarian_name")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("deworming_record")
}

model MedicationRecord {
  id             String    @id @default(uuid())
  petId          String    @map("pet_id")
  medicationName String    @map("medication_name")
  dosage         String
  frequency      String
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  lastNotifiedAt DateTime? @map("last_notified_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("medication_record")
}

model Appointment {
  id              String                @id @default(uuid())
  tutorId         String                @map("tutor_id")
  petId           String?               @map("pet_id")
  title           String
  description     String?
  scheduledAt     DateTime              @map("scheduled_at")
  durationMinutes Int                   @default(60) @map("duration_minutes")
  location        String?
  googleEventId   String?               @unique @map("google_event_id")
  googleEtag      String?               @map("google_etag")
  syncStatus      AppointmentSyncStatus @default(PENDING_CREATE) @map("sync_status")
  syncError       String?               @map("sync_error")
  lastSyncedAt    DateTime?             @map("last_synced_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tutor         Tutor          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  pet           Pet?           @relation(fields: [petId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tutorId, scheduledAt])
  @@index([syncStatus])
  @@map("appointment")
}

model Notification {
  id            String             @id @default(uuid())
  tutorId       String             @map("tutor_id")
  appointmentId String?            @map("appointment_id")
  kind          NotificationKind
  referenceType String             @map("reference_type")
  referenceId   String             @map("reference_id")
  payload       Json
  metadata      Json?
  fcmMessageId  String?            @map("fcm_message_id")
  status        NotificationStatus @default(PENDING)
  errorCode     String?            @map("error_code")
  sentAt        DateTime?          @map("sent_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  tutor       Tutor        @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tutorId, createdAt])
  @@index([referenceType, referenceId])
  @@map("notification")
}

model Veterinario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  password  String
  crmv      String   @unique
  telefone  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notasClinicas NotaClinica[]

  @@map("veterinario")
}

model NotaClinica {
  id            String   @id @default(uuid())
  veterinarioId String   @map("veterinario_id")
  petId         String   @map("pet_id")
  googlePlaceId String?  @map("google_place_id")
  diagnostico   String
  prescricao    String?
  observacoes   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  pet         Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([veterinarioId])
  @@index([petId])
  @@index([googlePlaceId])
  @@map("nota_clinica")
}
