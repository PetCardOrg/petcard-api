# ============================================
# PetCard API — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
# ============================================

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000

# ---------- Banco de Dados (PostgreSQL + PostGIS) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ---------- Autenticação (Auth0) ----------
AUTH0_DOMAIN=seu-tenant.us.auth0.com
AUTH0_CLIENT_ID=seu_client_id
AUTH0_CLIENT_SECRET=seu_client_secret
AUTH0_AUDIENCE=https://api.petcard.com

# ---------- Storage (AWS S3) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_S3_BUCKET=petcard-uploads-dev

# ---------- Cache (Redis) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Fila (RabbitMQ) ----------
RABBITMQ_URL=amqp://petcard:petcard123@localhost:5672
RABBITMQ_QR_CODE_QUEUE=qr-code.generate

# ---------- Notificações Push (Firebase) ----------
FIREBASE_PROJECT_ID=seu_project_id
FIREBASE_PRIVATE_KEY="sua_private_key"
FIREBASE_CLIENT_EMAIL=seu_client_email

# ---------- Google APIs ----------
GOOGLE_MAPS_API_KEY=sua_api_key
GOOGLE_CALENDAR_CLIENT_ID=seu_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=seu_client_secret

# ---------- Carteira Digital (Página Pública) ----------
# URL base usada no payload do QR Code. O "#" é obrigatório quando o web usa HashRouter.
PUBLIC_CARD_BASE_URL=https://card.petcard.app/#
# Rate-limit da rota pública GET /cards/:token
PUBLIC_CARD_THROTTLE_TTL_SECONDS=60
PUBLIC_CARD_THROTTLE_LIMIT=10

# ---------- JWT ----------
JWT_SECRET=uma_chave_secreta_qualquer
JWT_EXPIRES_IN=7d